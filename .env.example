# ==============================================================================
# CONFIGURACIÓN GENERAL DEL PROYECTO (Data Lake Saber 11)
# ==============================================================================
# Copia este archivo a .env y completa los valores. NUNCA subas el archivo .env al repositorio.

# AWS Región y Perfil
AWS_DEFAULT_REGION=us-east-1
AWS_PREFIX=saber11

# AWS Academy / IAM Role
# Si usas AWS Academy, el rol estándar preexistente para Glue, EMR y Lambda es 'LabRole'
AWS_IAM_ROLE_ARN=arn:aws:iam::TU_ACCOUNT_ID:role/LabRole

# AWS S3 Data Lake Buckets
# Nota: Los nombres de S3 deben ser globalmente únicos en AWS
S3_BUCKET_NAME=saber11-datalake-TU_ID_UNICO
S3_RAW_PATH=s3://${S3_BUCKET_NAME}/raw/
S3_TRUSTED_PATH=s3://${S3_BUCKET_NAME}/trusted/
S3_REFINED_PATH=s3://${S3_BUCKET_NAME}/refined/
S3_ATHENA_RESULTS_PATH=s3://${S3_BUCKET_NAME}/athena-query-results/

# Fuente 1: RDS MariaDB
RDS_HOST=saber11-mariadb.cxxxxxx.us-east-1.rds.amazonaws.com
RDS_PORT=3306
RDS_DATABASE=saber11_db
RDS_USER=admin_saber11
RDS_PASSWORD=TU_CONTRASENA_SEGURA

# Fuente 2: EC2 (Servidor de archivos CSV)
EC2_HOST=ec2-xx-xx-xx-xx.compute-1.amazonaws.com
EC2_USER=ec2-user
EC2_KEY_PATH=~/.ssh/saber11-key.pem
EC2_DATA_PATH=/home/ec2-user/data/saber11/

# Fuente 3: Portal Datos Abiertos (Socrata API)
SOCRATA_DATASET_ID=kgxf-xxbe
SOCRATA_DIVIPOLA_ID=gdxc-w37w
# Opcional pero recomendado para evitar límites de tasa (429):
SOCRATA_APP_TOKEN=

# Glue Data Catalog & Athena
GLUE_DATABASE=saber11_catalog
GLUE_RAW_TABLE=raw_saber11
GLUE_TRUSTED_TABLE=trusted_saber11
